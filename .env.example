# Teacher App - Environment Variables
# Copy this to .env.development, .env.staging, or .env.production
# Expo automatically loads:
#   .env.development  → when running `npx expo start`
#   .env.production   → when running `npx expo start --no-dev`
#   .env.staging      → not auto-loaded; use DOTENV_STAGING=true

EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_ENV_NAME=development
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENABLE_NOTIFICATIONS=true
